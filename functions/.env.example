# Copy to functions/.env (gitignored) and fill in real values.
# Everything here is SERVER-SIDE config — never shipped to the browser bundle.

# bootstrapAdmin grants { admin: true } ONLY to a signed-in user whose verified
# email matches this value.
ADMIN_EMAIL=you@example.com

# Sanity Administrator-scoped write token. Used by publishResena to create the
# reseña/hueca docs and upload image assets. Generate in Sanity → API → Tokens.
SANITY_WRITE_TOKEN=sk-your-sanity-write-token

# Anthropic API key. Used by generateResenaDraft to draft the reseña body.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Claude model id for generateResenaDraft (falls back to claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
