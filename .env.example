# Copy to .env.local (gitignored) and fill in. .env.local takes precedence.
# Without VITE_MAPTILER_KEY the app falls back to a keyless raster street
# basemap (Carto Voyager over OpenStreetMap) — real streets, no account needed.
# Set a key to upgrade to MapTiler vector streets (https://www.maptiler.com/).

VITE_MAPTILER_KEY=

# Sanity READ config (reused from the blog-component library's project).
# These are PUBLIC, non-secret values — safe to ship in the frontend bundle and
# safe to commit here. Reads use the public CDN client (useCdn: true, no token).
#
# NOTE: the Sanity WRITE token and the Anthropic API key are NOT frontend vars.
# They are secrets that live server-side in a later Cloud Function — never add
# them as VITE_* variables (anything VITE_-prefixed is exposed to the browser).
VITE_SANITY_PROJECT_ID=gvc4yjqj
VITE_SANITY_DATASET=production

# Firebase web config — PUBLIC, NON-SECRET browser identifiers.
# The Firebase web config (including the apiKey) is meant to be shipped in the
# frontend bundle; it identifies the project, it does not authorize access.
# Real security comes from Firebase Auth provider settings + Auth rules and the
# server-side Cloud Function (which holds the actual secrets / Admin SDK).
# Get these from Firebase Console → Project settings → Your apps → SDK setup.
# Put REAL values in .env.local (gitignored); keep only placeholders here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
