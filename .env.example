# Copy to .env.local (gitignored) and fill in. .env.local takes precedence.
# Without VITE_MAPTILER_KEY the app falls back to MapLibre demo tiles
# (low-detail world map, fine for dev — get a free key at https://www.maptiler.com/).

VITE_MAPTILER_KEY=

# Sanity READ config (reused from the blog-component library's project).
# These are PUBLIC, non-secret values — safe to ship in the frontend bundle and
# safe to commit here. Reads use the public CDN client (useCdn: true, no token).
#
# NOTE: the Sanity WRITE token and the Anthropic API key are NOT frontend vars.
# They are secrets that live server-side in a later Cloud Function — never add
# them as VITE_* variables (anything VITE_-prefixed is exposed to the browser).
VITE_SANITY_PROJECT_ID=gvc4yjqj
VITE_SANITY_DATASET=production
